# Exact public URL, no trailing slash. Production must use HTTPS.
APP_ORIGIN=http://localhost:3000
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required only for the first owner's registration. Remove after registration.
BOOTSTRAP_TOKEN=
# Persist this path on a disk/volume. Never put it in an ephemeral deployment directory.
DATABASE_PATH=./data/life.sqlite
